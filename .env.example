# ===== RunFit 配置模板 =====
# 复制为 .env 后填写自己的值。改完需要重启服务。

# --- 服务 ---
GRF_HOST=0.0.0.0
GRF_PORT=7788
GRF_DEBUG=0

# --- 会话 ---
GRF_SESSION_TTL_HOURS=720
GRF_ALLOW_REGISTER=1

# --- AI 教练（DeepSeek，OpenAI 兼容协议）---
# 在 https://platform.deepseek.com/api_keys 创建
GRF_LLM_API_KEY=
GRF_LLM_BASE_URL=https://api.deepseek.com
GRF_LLM_MODEL=deepseek-flash
GRF_LLM_VISION_MODEL=deepseek-flash
GRF_LLM_TIMEOUT=120

# --- 上传 ---
GRF_MAX_UPLOAD_MB=256